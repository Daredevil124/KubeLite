# 1. Compiled Binaries
# You never want to commit the actual executable files.
# Anyone cloning the repo will compile the code themselves.
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
orchestrator  # Add the specific name of your compiled Go binary here!
Worker/Worker # Compiled binary for the Worker node
Master/Master # Compiled binary for the Master node

# 2. Dependency Folders
# Go handles dependencies via go.mod. If you use the 'vendor' command,
# it creates a massive folder of code you don't need to commit.
vendor/

# 3. Environment & Secret Files (CRUCIAL)
# If you ever use a .env file for Redis passwords, AWS keys, or API tokens,
# this ensures you never accidentally leak them on GitHub.
.env
*.env
.env.local

# 4. IDE and OS Specific Folders
# These are generated by your code editor or operating system and
# are useless to anyone else working on the project.
.vscode/
.idea/
.DS_Store
